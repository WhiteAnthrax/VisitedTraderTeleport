<?xml version="1.0" encoding="UTF-8" ?>
<VisitedTraderTeleport>
  <!-- Access modes mainly matter in multiplayer. Single-player can keep personal. -->
  <!-- In multiplayer, the server-side file is authoritative. -->
  <!-- personal: only traders this player visits -->
  <!-- party: this player plus current party members -->
  <!-- shared: everyone in the active save/server -->
  <AccessMode value="personal" />

  <!-- Optional travel cost. Leave enabled=false for the current free-travel behavior. -->
  <!-- item is the internal item name to consume. ammoGasCan is vanilla gas. -->
  <!-- perMeter is charged by straight-line distance and rounded up to a whole item count. -->
  <!-- perKilometer from older configs is still supported; perMeter takes priority when both are set. -->
  <TravelCost enabled="false" item="ammoGasCan" displayName="gas" perMeter="1.5" minimum="0" />

  <!-- Short transport-style transition before travel. -->
  <!-- disableCamera briefly hides the trip. sound uses a loaded game audio key; set sound empty to disable audio. -->
  <TravelTransition enabled="true" durationSeconds="5" disableCamera="true" sound="suv_startup" />
</VisitedTraderTeleport>
