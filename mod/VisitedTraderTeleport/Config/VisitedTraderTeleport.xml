<?xml version="1.0" encoding="UTF-8" ?>
<VisitedTraderTeleport>
  <!-- Access modes mainly matter in multiplayer. Single-player can keep personal. -->
  <!-- In multiplayer, the server-side file is authoritative. -->
  <!-- personal: only traders this player visits -->
  <!-- party: this player plus current party members -->
  <!-- shared: everyone in the active save/server -->
  <AccessMode value="personal" />

  <!-- Test mode for local verification only. Leave false for normal play. -->
  <!-- true: talking to any trader records all known traders for that player. -->
  <!-- Test destinations are saved two blocks in front of each trader's facing direction. -->
  <TestRecordAllTradersOnVisit value="false" />
</VisitedTraderTeleport>
