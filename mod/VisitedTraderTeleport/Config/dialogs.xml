<configs>
  <insertBefore xpath="/dialogs/dialog[@id='trader']/statement[@id='start']/response_entry[@id='done']">
    <response_entry id="vtt_open" />
  </insertBefore>

  <append xpath="/dialogs/dialog[@id='trader']">
    <statement id="vtt_destinations" text="vtt_statement_destinations">
      <response_entry id="nevermind" />
    </statement>

    <statement id="vtt_confirm" text="vtt_statement_confirm">
      <response_entry id="vtt_confirm_no" />
    </statement>

    <statement id="vtt_forget_confirm" text="vtt_statement_forget">
      <response_entry id="vtt_forget_no" />
    </statement>

    <response id="vtt_open" text="vtt_response_open" nextstatementid="vtt_destinations" />
    <response id="vtt_confirm_no" text="vtt_confirm_no" nextstatementid="vtt_destinations" />
    <response id="vtt_forget_no" text="vtt_forget_no" nextstatementid="vtt_destinations" />
  </append>
</configs>
