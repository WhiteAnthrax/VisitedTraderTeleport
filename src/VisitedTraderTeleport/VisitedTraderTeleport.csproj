<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>VisitedTraderTeleport</AssemblyName>
    <RootNamespace>VisitedTraderTeleport</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- MSB3277 for System.Net.Http, System.IO.Compression, and System.ValueTuple
         comes from dependency identities embedded in the game-provided Assembly-CSharp
         and 0Harmony binaries. Project-side resolution changes cannot alter them; builds
         succeed, so these known informational warnings are intentionally accepted. -->
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\..\refs\managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>..\..\refs\managed\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\..\refs\managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>..\..\refs\managed\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>..\..\refs\managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\..\refs\managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\..\refs\harmony\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\..\refs\managed\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyToModFolder" AfterTargets="Build">
    <MakeDir Directories="..\..\mod\VisitedTraderTeleport" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="..\..\mod\VisitedTraderTeleport" />
  </Target>

  <Target Name="PackageMod" AfterTargets="CopyToModFolder">
    <XmlPeek
      XmlInputPath="..\..\mod\VisitedTraderTeleport\ModInfo.xml"
      Query="/xml/Version/@value">
      <Output TaskParameter="Result" PropertyName="ModVersion" />
    </XmlPeek>
    <PropertyGroup>
      <PackageRoot>$(BaseIntermediateOutputPath)Package\</PackageRoot>
      <PackageModDir>$(PackageRoot)VisitedTraderTeleport\</PackageModDir>
    </PropertyGroup>
    <MakeDir Directories="..\..\dist" />
    <Copy SourceFiles="..\..\CHANGELOG.md" DestinationFiles="..\..\mod\VisitedTraderTeleport\Changelog.txt" />
    <RemoveDir Directories="$(PackageRoot)" />
    <MakeDir Directories="$(PackageModDir)" />
    <ItemGroup>
      <ModPackageFiles Include="..\..\mod\VisitedTraderTeleport\**\*.*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(ModPackageFiles)"
      DestinationFiles="@(ModPackageFiles->'$(PackageModDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="..\..\LICENSE" DestinationFiles="$(PackageModDir)LICENSE" />
    <ZipDirectory
      SourceDirectory="$(PackageRoot)"
      DestinationFile="..\..\dist\VisitedTraderTeleport-$(ModVersion).zip"
      Overwrite="true" />
  </Target>
</Project>
